# =========================================================
# Sao chép file này thành .env và điền API key thật.
# KHÔNG commit file .env vào git.
# =========================================================

# --- Nhà cung cấp LLM: dùng Google Gemini ---
MODEL_PROVIDER=google
MODEL_NAME=gemini-3.1-flash-lite
API_KEY=

# Có thể dùng GOOGLE_API_KEY hoặc GEMINI_API_KEY thay cho API_KEY,
# nhưng baseline giữ API_KEY để đúng cấu trúc config ban đầu.

# --- Embedding: ---
# Mặc định dùng cùng Google API key phía trên.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# true: chỉ dùng bộ nhớ đệm local, không kiểm tra/tải file từ Hugging Face Hub.
# Chỉ bật sau khi model đã được tải đầy đủ ít nhất một lần.
EMBEDDING_LOCAL_FILES_ONLY=false
# Để trống => tự chuyển dự phòng sang API_KEY.
EMBEDDING_API_KEY=

# Nếu muốn embedding local sau này:
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Cơ sở dữ liệu vector ---
VECTOR_DB_PATH=./data/vector_db
VECTOR_DB_COLLECTION=ai_agent_security_kb

# --- Truy xuất ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.20

# --- Executor ---
EXECUTOR_TOOL_TIMEOUT_SECONDS=10

# --- Bảo mật / chế độ phòng thủ ---
# off | on
DEFENSE_MODE=off

# --- Tracing / theo dõi ---
LOG_LEVEL=INFO
TRACE_OUTPUT_DIR=./tracing/logs
TRACE_FILE_NAME=agent_trace.jsonl
TRACE_MAX_EVENT_BYTES=256000
TRACE_MAX_FILE_BYTES=10000000
TRACE_BACKUP_COUNT=5
